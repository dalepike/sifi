# Database
# For local development with Docker:
DATABASE_URL=postgresql://sifi:sifi_dev_password@localhost:5432/sifi
# For Railway (use the connection string from Railway dashboard):
# DATABASE_URL=postgresql://user:pass@host:5432/sifi?sslmode=require

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-key-at-least-32-characters-long
NEXTAUTH_URL=http://localhost:3000

# Legacy SQLite path (remove after migration)
# DATABASE_PATH=./sifi.db
